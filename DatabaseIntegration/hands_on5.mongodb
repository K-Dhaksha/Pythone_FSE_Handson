db.feedback.countDocuments();

db.feedback.find({
    rating:5
})
db.feedback.find({
    $and:[
        {course_code:"CS101"},
        {tags: 'challenging'}
    ]
});
db.feedback.find({}, {
    student_id:1,
    course_code:1,
    rating:1,
    _id:0
});

db.feedback.updateMany(
    {rating: {$lt:3}},
    {$set: {needs_review: true}}
);
db.feedback.updateMany(
    {needs_review: true},
    {$push: {tags: 'reviewed'}}
);

db.feedback.deleteMany({semester:'2021-EVEN'});

db.feedback.aggregate([
    // Stage 1 - filter
    { $match: { semester: '2022-ODD' } },
    
    // Stage 2 - group
    { $group: {
        _id: '$course_code',
        avg_rating: { $avg: '$rating' },
        total_feedback: { $sum: 1 }
    }},
    
    // Stage 3 - sort
    { $sort: { avg_rating: -1 } },
    
    // Stage 4 - rename and round
    { $project: {
        course_code: '$_id',
        average_rating: { $round: ['$avg_rating', 1] },
        total_feedback: 1,
        _id: 0
    }}
]);

db.feedback.aggregate([
    // Stage 1: unwind tags array
    { $unwind: '$tags' },
    
    // Stage 2: group by tag and count
    { $group: { _id: '$tags', count: {$sum:1} }},

    // Stage 3: sort by count descending
    { $sort: { count: -1 }}
]);

db.feedback.createIndex({ course_code: 1 });

db.feedback.find({ course_code: 'CS101' }).explain('executionStats');

